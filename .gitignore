# ==========================================
# Dependencies
# ==========================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Next.js & Build Outputs
# ==========================================
.next/
out/
build/
dist/

# ==========================================
# TypeScript & Cache
# ==========================================
*.tsbuildinfo
next-env.d.ts
.turbo/

# ==========================================
# Environment Variables & Secrets (NEVER COMMIT)
# ==========================================
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow committing example environment file if created
!.env.example

# ==========================================
# Debug & Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
*.lcov
.nyc_output

# ==========================================
# Vercel Deployment
# ==========================================
.vercel

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==========================================
# IDE & Code Editors
# ==========================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# SSL / Certificates / Private Keys
# ==========================================
*.pem
*.key
*.cert
